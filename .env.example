# Copie para .env e ajuste. Nunca faça commit do .env.

POSTGRES_USER=orcamento
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=orcamento

# Usado pela API (dentro do Docker o host é "db")
DATABASE_URL=postgresql+psycopg://orcamento:troque-esta-senha@db:5432/orcamento

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=troque-por-uma-chave-aleatoria-longa

ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
# Endereço do frontend usado nos links dos e-mails
FRONTEND_URL=http://localhost:5173

# E-mail: "console" imprime no log da API (desenvolvimento); "smtp" envia de verdade.
EMAIL_BACKEND=console
EMAIL_FROM=Meu Orçamento <nao-responda@localhost>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ---------------------------------------------------------------- mercado (opcional)
# Token grátis de https://brapi.dev: libera Ibovespa/IFIX e mais consultas no Mercado.
BRAPI_TOKEN=

# E-mails (separados por vírgula) que leem as sugestões enviadas pelo app.
ADMIN_EMAILS=
