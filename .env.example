# Copie para .env e ajuste. Nunca faça commit do .env.

POSTGRES_USER=orcamento
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=orcamento

# Usado pela API (dentro do Docker o host é "db")
DATABASE_URL=postgresql+psycopg://orcamento:troque-esta-senha@db:5432/orcamento

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=troque-por-uma-chave-aleatoria-longa

ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
