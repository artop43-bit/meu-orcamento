# syntax=docker/dockerfile:1
FROM --platform=$BUILDPLATFORM golang:1.27.1 AS builder
ARG TARGETOS
ARG TARGETARCH
WORKDIR /src
ADD https://github.com/ReceitaFederal/calculadora-rtc-gerador-danfse.git#8d79e6b2f7fad6375340afcb51c85ed370c64a14 .
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -o /out/danfse ./cmd/danfse

FROM alpine:3.23
COPY --from=builder /out/danfse /usr/local/bin/danfse
COPY --from=builder /src/LICENSE /app/LICENSE.receita-federal
COPY --from=builder /usr/share/zoneinfo/America/Sao_Paulo /usr/share/zoneinfo/America/Sao_Paulo
ENV TZ=America/Sao_Paulo OTEL_SDK_DISABLED=true
USER 10001:10001
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/danfse"]
