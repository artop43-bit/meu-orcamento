# Copie para .env.production NO SERVIDOR e preencha. Nunca faça commit desse arquivo.
#   cp .env.production.example .env.production && chmod 600 .env.production

# ---------------------------------------------------------------- site
# Domínio sem https:// e sem www (o www redireciona para ele).
DOMAIN=meuorcamento.com.br

# ---------------------------------------------------------------- banco
POSTGRES_USER=orcamento
POSTGRES_DB=orcamento
# Gere com: openssl rand -base64 32 | tr -d '/+=' | cut -c1-32
POSTGRES_PASSWORD=

# ---------------------------------------------------------------- API
# Gere com: openssl rand -base64 64 | tr -d '\n'
# ATENÇÃO: também protege os segredos de 2FA. Trocar depois invalida o 2FA de todos.
SECRET_KEY=
TIMEZONE=America/Sao_Paulo

# ---------------------------------------------------------------- e-mail (Brevo, Resend…)
EMAIL_BACKEND=smtp
EMAIL_FROM=Meu Orçamento <nao-responda@meuorcamento.com.br>
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ---------------------------------------------------------------- backup
# Chave PÚBLICA age (começa com "age1..."). A privada fica com você, fora do servidor.
BACKUP_AGE_RECIPIENT=
# Horário (cron) e retenção. Padrão: todo dia às 03:30, 7 dias no servidor, 30 no bucket.
BACKUP_SCHEDULE=30 3 * * *
BACKUP_LOCAL_RETENTION_DAYS=7
BACKUP_REMOTE_RETENTION_DAYS=30

# Object Storage da Oracle (API compatível com S3). Veja docs/DEPLOY.md, passo 7.
# Endpoint: https://<namespace>.compat.objectstorage.<região>.oraclecloud.com
OCI_S3_ENDPOINT=
OCI_REGION=sa-saopaulo-1
OCI_BUCKET=meu-orcamento-backups
OCI_ACCESS_KEY_ID=
OCI_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------- mercado (opcional)
# Token grátis de https://brapi.dev: libera Ibovespa/IFIX e mais consultas no Mercado.
BRAPI_TOKEN=
